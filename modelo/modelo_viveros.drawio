        <mxCell id="text0" value="Tajinaste S.A. · Modelo entidad/relación completo" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=40;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1238.1999999999998" y="36.0" width="1323.6000000000001" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="11 entidades · 10 relaciones · 1 especialización parcial · 37 atributos visibles" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1330.6" y="96.3" width="1138.8" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="El puesto conserva empleado, zona, tarea y fechas. El objetivo de venta se asigna al empleado." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=23;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1171.54" y="138.9" width="1456.92" height="32.199999999999996" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="parcial" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="3328.42" y="2177.4" width="113.16000000000001" height="25.2" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="total = Σ cantidad × precio_unitario · volumen_compras = Σ total del cliente en el mes, desde su ingreso en Plus" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1071.88" y="3274.6" width="1656.24" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="Triángulo ISA: CLIENTE_PLUS es un subconjunto de CLIENTE y hereda su identificador, nombre y contacto." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1178.1399999999999" y="3315.3" width="1443.72" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text6" value="Cardinalidad junto a una entidad = participaciones de cada instancia de esa entidad." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1358.32" y="3356.7" width="1083.3600000000001" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text7" value="Subrayado: clave · Óvalo discontinuo: derivado · Doble borde: entidad débil / relación identificadora." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1279.12" y="3387.4" width="1241.76" height="25.2" as="geometry" />
        </mxCell>
      </root>
