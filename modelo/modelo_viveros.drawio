        <mxCell id="card14" value="(1,1)" style="text;html=1;fillColor=#ffffff;strokeColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1608" y="1134" width="84" height="32" as="geometry" />
        </mxCell>
        <mxCell id="text0" value="Historial de puestos y objetivos de venta" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=40;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="543.8" y="36.0" width="1112.4" height="56.0" as="geometry" />
        </mxCell>
        <mxCell id="text1" value="Los puestos conservan dónde y en qué trabaja la persona. Sus objetivos siguen vinculados al empleado." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=21;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="385.06999999999994" y="96.3" width="1429.8600000000001" height="29.4" as="geometry" />
        </mxCell>
        <mxCell id="text2" value="ZONA: atributos en la página 2." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1530.63" y="831.7" width="418.74" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text3" value="PEDIDO: atributos en la página 4." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1518.09" y="1311.7" width="443.82" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text4" value="Un empleado nunca tiene puestos simultáneos en viveros distintos." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="570.1999999999999" y="193.2" width="1059.6000000000001" height="33.599999999999994" as="geometry" />
        </mxCell>
        <mxCell id="text5" value="Cambiar de zona o tarea crea otro puesto. Los registros anteriores se conservan." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="504.19999999999993" y="239.6" width="1191.6000000000001" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text6" value="La fecha del pedido debe quedar dentro del intervalo del puesto gestor." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="569.54" y="284.6" width="1060.92" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text7" value="Un objetivo puede abarcar varios puestos sucesivos del mismo empleado." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#20314c;fontSize=22;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="576.8" y="329.6" width="1046.4" height="30.799999999999997" as="geometry" />
        </mxCell>
        <mxCell id="text8" value="Cardinalidad junto a una entidad = participaciones de cada instancia de esa entidad." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="558.3199999999999" y="1546.7" width="1083.3600000000001" height="26.599999999999998" as="geometry" />
        </mxCell>
        <mxCell id="text9" value="Subrayado: clave · Óvalo discontinuo: derivado · Doble borde: entidad débil / relación identificadora." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=DejaVu Sans;fontColor=#5b6c83;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="479.12" y="1577.4" width="1241.76" height="25.2" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
